# Postgres — installed natively, no Docker. The Homebrew postgresql@16 cluster
# listens on :5433, not the default :5432.
#
# DATABASE_URL is the dev/demo database. When it points at Supabase's pgbouncer
# (:6543), append connection_limit — Prisma otherwise sizes its pool at
# cpus * 2 + 1 (17 on an 8-core machine) and overshoots the pooler's pool,
# which surfaces as intermittent "Can't reach database server" after ~5s:
#   ...?pgbouncer=true&connection_limit=5&connect_timeout=15
DATABASE_URL="postgresql://localhost:5433/bhaav?schema=public"

# MUST be a local, disposable database — NEVER Supabase or any shared host.
# test/setup.js assigns DATABASE_URL = DATABASE_URL_TEST, and the suite calls
# truncateAll() in beforeEach, TRUNCATEing all 11 tables before EVERY test.
# Aiming this at a shared database empties it completely.
DATABASE_URL_TEST="postgresql://localhost:5433/bhaav_test?schema=public"

# Leave BHAAV_ALLOW_REMOTE_TEST_DB UNSET. It disarms the guard in
# test/helpers/db.js that refuses to truncate a non-local target.

# Prisma Migrate needs an unpooled connection when DATABASE_URL goes through a
# pooler (e.g. Supabase pgbouncer on :6543) — point this at the direct :5432 URL.
DIRECT_URL="postgresql://localhost:5433/bhaav?schema=public"

# Express
PORT=4000
NODE_ENV="development"
SESSION_SECRET="generate-with-openssl-rand-hex-32"
PHOTO_DIR="./server/api/uploads"
# Exact scheme+host of the deployed console (no trailing slash). Required in
# production — the CORS allow-list (app.js) and the session cookie's
# sameSite/secure attributes (auth.js) both key off this and off NODE_ENV.
CONSOLE_ORIGIN="http://localhost:3000"

# client/console (client/console/.env.local, or the host's env var UI when deployed)
# Public API base URL the console's Next.js server proxies /api/* to
# (next.config.js rewrites). No trailing slash.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# server/aiml
AIML_PREDICT_URL="https://sihmodel.vercel.app"
# server/aiml runs here. This MUST NOT be the same host as AIML_PREDICT_URL —
# they are two different services and pointing both at one host silently 404s
# whichever route that host lacks, invisibly, because both callers fail open.
AIML_DETECT_URL="http://127.0.0.1:8099"
AIML_TIMEOUT_MS=2000

# Fast2SMS — route "q" (Quick SMS) needs no DLT registration.
# SMS_ENABLED defaults OFF. The seeded recycler numbers are REAL businesses from
# the MPCB register; set SMS_ALLOWLIST to your own phone for the whole build and
# an accidental broadcast becomes structurally impossible.
FAST2SMS_API_KEY=""
SMS_ENABLED="false"
SMS_DRY_RUN="true"
SMS_ALLOWLIST=""
SMS_TIMEOUT_MS=3000
# Routing, not a safety guard. When set, EVERY outbound SMS is redirected to
# this one number instead of the intended recipient (the intended number is
# logged). Lets a demo exercise the collector->recycler direction without
# editing the seeded MPCB phone numbers. Applied before SMS_ALLOWLIST, so it
# can never reach a number the allowlist would reject. Leave empty in prod.
SMS_REDIRECT_TO=""
