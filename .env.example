# Postgres — installed natively, no Docker
DATABASE_URL="postgresql://localhost:5432/bhaav?schema=public"
DATABASE_URL_TEST="postgresql://localhost:5432/bhaav_test?schema=public"

# Express
PORT=4000
SESSION_SECRET="generate-with-openssl-rand-hex-32"
PHOTO_DIR="./server/api/uploads"

# server/aiml
AIML_PREDICT_URL="https://sihmodel.vercel.app"
# server/aiml runs here. This MUST NOT be the same host as AIML_PREDICT_URL —
# they are two different services and pointing both at one host silently 404s
# whichever route that host lacks, invisibly, because both callers fail open.
AIML_DETECT_URL="http://127.0.0.1:8099"
AIML_TIMEOUT_MS=2000
