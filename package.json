{
  "name": "bhaav",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server/api",
    "client/console"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,console,app -c blue,magenta,green \"npm -w @bhaav/api run dev\" \"npm -w @bhaav/console run dev\" \"npm --prefix client/app start\"",
    "start": "npm run start:prod --workspace=server/api",
    "seed": "npm -w @bhaav/api run seed",
    "migrate": "npm -w @bhaav/api run migrate",
    "test": "vitest run",
    "db:backup": "npm -w @bhaav/api run db:backup",
    "db:restore": "npm -w @bhaav/api run db:restore"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^2.1.8"
  }
}
