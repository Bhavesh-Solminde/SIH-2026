{
  "name": "@bhaav/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=../../.env --watch src/server.js",
    "start": "node --env-file=../../.env src/server.js",
    "start:prod": "node src/server.js",
    "prestart:prod": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "node --env-file=../../.env seed/seed.js",
    "test": "vitest run",
    "db:backup": "node --env-file=../../.env scripts/db-snapshot.js backup",
    "db:restore": "node --env-file=../../.env scripts/db-snapshot.js restore",
    "mpcb:refresh": "node scripts/mpcb-refresh.js"
  },
  "dependencies": {
    "@bhaav/core": "*",
    "@prisma/client": "^6.1.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
